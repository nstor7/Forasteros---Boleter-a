# Copia este archivo a .env.local y llena los valores.
# .env.local NUNCA se sube a git.

# --- Supabase (base de datos) ---
# supabase.com -> tu proyecto -> Settings -> API Keys
# Usa la llave "secret" (sb_secret_...). Reemplaza a la vieja service_role.
# Es de servidor: nunca la expongas en el navegador ni la subas a git.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- PayPal ---
# developer.paypal.com -> Apps & Credentials -> Create App
# Empieza en sandbox; cambia a live solo cuando vayas a vender de verdad.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Email (pendiente: se activa cuando exista el dominio) ---
RESEND_API_KEY=
EMAIL_FROM="Los Forasteros del Tango <boletos@forasterosdeltango.com>"

# --- Seguridad ---
# Genera cada uno con: openssl rand -base64 32
TICKET_SECRET=
SESSION_SECRET=
ADMIN_PASSWORD=
SCANNER_PIN=

# --- Evento ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
